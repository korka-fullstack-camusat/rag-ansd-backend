OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4.1-nano
# Origines autorisees a appeler l'API (URL du frontend), separees par des virgules
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Mot de passe du tableau de bord admin (/admin du frontend). Vide = tableau de bord desactive.
ADMIN_TOKEN=changez-moi

# --- Montee en charge (valeurs par defaut raisonnables) ---
# Cache partage et limitation de debit (vide = memoire locale a chaque processus)
REDIS_URL=
# Processus par conteneur (~ un par coeur CPU)
WEB_CONCURRENCY=4
# Duree de vie des reponses en cache (secondes)
CACHE_TTL_SECONDS=86400
# Questions max par minute et par utilisateur / par adresse IP
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_IP_PER_MINUTE=600
# Connexions simultanees max vers le fournisseur du modele, par processus
LLM_MAX_CONNECTIONS=200

# --- Voix (wolof) : Soynade, https://developers.soynade.ai ---
# Cle API Soynade (reconnaissance vocale + synthese). Vide = mode vocal desactive.
SOYNADE_API_KEY=
